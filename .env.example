# Local development template. setup_local.sh replaces the key and DB placeholders.
DEBUG=True
SECRET_KEY=auto-generated-by-setup-script
FERNET_KEY=auto-generated-by-setup-script

DB_NAME=schoolforumdb
DB_USER=your_postgres_username
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Optional alternative: DATABASE_URL=postgresql://user:password@localhost:5432/schoolforumdb
# Exported environment variables override .env values.

# Email (optional; supply real SMTP settings to send mail)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
SITE_URL=http://localhost:8000

# Background workers (optional; requires Redis and separate Celery processes)
# REDIS_URL=redis://localhost:6379
